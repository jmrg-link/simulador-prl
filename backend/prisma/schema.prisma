generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Una sesión de formación: un alumno con las gafas puestas recorriendo un escenario.
model TrainingSession {
  id           String        @id @default(uuid()) @db.Uuid
  traineeName  String
  scenarioId   String
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  hazardEvents HazardEvent[]
  liveStreams  LiveStream[]
  recording    Recording?
}

/// Un riesgo del escenario que el alumno ha identificado, con su tiempo de reacción y la
/// actuación que eligió. `measureCorrect` lo calcula el servidor; el alumno nunca ve la respuesta.
model HazardEvent {
  id             String          @id @default(uuid()) @db.Uuid
  sessionId      String          @db.Uuid
  hazardId       String
  reactionMs     Int
  detectedAt     DateTime        @default(now())
  chosenOption   Int?
  measureCorrect Boolean?
  session        TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, hazardId])
}

enum LiveStreamStatus {
  STARTING
  LIVE
  ENDED
}

/// Emisión RTMP → HLS de una sesión de formación.
model LiveStream {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @db.Uuid
  status    LiveStreamStatus @default(STARTING)
  createdAt DateTime         @default(now())
  liveAt    DateTime?
  endedAt   DateTime?
  session   TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum RecordingStatus {
  RECORDING
  PROCESSING
  READY
  FAILED
}

/// Grabación MP4 de una sesión de formación, con capítulos por riesgo identificado.
model Recording {
  id         String          @id @default(uuid()) @db.Uuid
  sessionId  String          @unique @db.Uuid
  status     RecordingStatus @default(RECORDING)
  startedAt  DateTime        @default(now())
  durationMs Int?
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
